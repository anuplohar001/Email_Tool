<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Template - Email Scheduler</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav>
    <a href="/">Dashboard</a>
    <a href="/upload">Upload Excel</a>
    <a href="/template">Edit Template</a>
  </nav>

  <main>
    <h1>Edit Email Template</h1>
    <p>Use <code>{{company}}</code> and <code>{{role}}</code> as placeholders.</p>

    <% if (saved) { %>
      <div class="result">
        <p>Template saved successfully.</p>
      </div>
    <% } %>

    <form method="POST" action="/template">
      <label>Subject</label>
      <input type="text" name="subject" value="<%= subject %>" style="width:100%;padding:8px;margin-bottom:12px">

      <label>Body (HTML)</label>
      <textarea name="body" rows="12" style="width:100%;padding:8px"><%= body %></textarea>

      <br><br>
      <button type="submit" class="btn btn-ok">Save Template</button>
    </form>
  </main>
</body>
</html>
