<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Templates - Email Scheduler</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav>
    <a href="/">Dashboard</a>
    <a href="/upload">Upload Excel</a>
    <a href="/template">Edit Template</a>
    <a href="/resume">Resume</a>
  </nav>

  <main>
    <h1>Edit Email Templates</h1>
    <p>Use <code>{{company}}</code> and <code>{{role}}</code> as placeholders.</p>

    <% if (saved) { %>
      <div class="result">
        <p>Templates saved successfully.</p>
      </div>
    <% } %>

    <form method="POST" action="/template">
      <div class="create-form">
        <h2>Initial Template — 1st send</h2>
        <p>This template is used for the first email of each job.</p>
        <label>Subject</label>
        <input type="text" name="initialSubject" value="<%= templates.initial.subject %>" style="width:100%;padding:8px;margin-bottom:12px">

        <label>Body (HTML)</label>
        <textarea name="initialBody" rows="12" style="width:100%;padding:8px"><%= templates.initial.body %></textarea>
      </div>

      <div class="create-form">
        <h2>Follow-up Template — 2nd &amp; 3rd send</h2>
        <p>This template is used automatically for all sends after the first one.</p>
        <label>Subject</label>
        <input type="text" name="followupSubject" value="<%= templates.followup.subject %>" style="width:100%;padding:8px;margin-bottom:12px">

        <label>Body (HTML)</label>
        <textarea name="followupBody" rows="12" style="width:100%;padding:8px"><%= templates.followup.body %></textarea>
      </div>

      <button type="submit" class="btn btn-ok">Save Templates</button>
    </form>
  </main>
</body>
</html>
